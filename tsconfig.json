{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Only legal and safe because noEmit is set: tsc must never emit JS while .ts import extensions are used.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // `tools` is in here on purpose: without it `npm run typecheck` passes while the
  // conformance CLI is entirely untyped, which is the quietest way for a tool to rot.
  "include": ["contracts.ts", "src", "tests", "data", "tools", "vitest.config.ts", "vite.config.ts"]
}
